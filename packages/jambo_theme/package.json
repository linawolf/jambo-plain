{
    "name": "jambo-theme",
    "version": "1.0.0",
    "private": true,
    "description": "Stylesheet build for the Jambo County Council sitepackage",
    "license": "GPL-2.0-or-later",
    "scripts": {
        "build": "npm run build:css && npm run build:vendor",
        "build:css": "sass --no-source-map --style=expanded Resources/Private/Scss/main.scss Resources/Public/Css/main.css",
        "build:vendor": "cp node_modules/swiper/swiper-bundle.min.js Resources/Public/JavaScript/swiper-bundle.min.js && cp node_modules/swiper/swiper-bundle.min.css Resources/Public/Css/swiper-bundle.min.css",
        "watch": "sass --watch --style=expanded Resources/Private/Scss/main.scss Resources/Public/Css/main.css"
    },
    "devDependencies": {
        "sass": "^1.95.0",
        "swiper": "^14.3.0"
    }
}
